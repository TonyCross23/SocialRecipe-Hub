# Backend hostname only, without https:// or a path.
API_DOMAIN=
# Email for Let's Encrypt account and certificate notices.
LETSENCRYPT_EMAIL=
# Exact HTTPS origin(s) of the Vercel frontend, comma-separated, without paths.
CORS_ORIGINS=

# Generated once by npm run production:env. Preserve them on subsequent deploys.
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
METRICS_TOKEN=
JWT_ISSUER=socialrecipe-api
JWT_AUDIENCE=socialrecipe-clients
LOG_LEVEL=info

# Optional administrator bootstrap. Existing passwords and bans are preserved.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_DOB=2000-01-01

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
AI_CHAT_LANGUAGE=english
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_WORKER_INTERVAL_MS=5000

# Real SMTP delivery; Mailpit is not part of the production stack.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=
