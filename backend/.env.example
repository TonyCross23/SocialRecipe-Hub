NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://recipe:recipe_local_only@localhost:5432/socialrecipe?schema=public
# Generate two DIFFERENT secrets with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-48-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-48-characters
JWT_ISSUER=socialrecipe-api
JWT_AUDIENCE=socialrecipe-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_TTL_SECONDS=2592000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set only when behind a trusted reverse proxy; number of proxy hops.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
# Optional Cloudinary account credentials. Set all three to enable image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. When set, pending moderation jobs are processed in the background.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_WORKER_INTERVAL_MS=5000
# Required to scrape GET /metrics. Generate a random value for production.
METRICS_TOKEN=replace-with-a-random-metrics-token-at-least-32-characters

# Groq conversational AI Cook (server only)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
AI_CHAT_LANGUAGE=english

# Enable after Expo/Firebase push credentials are configured.
PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=

# Docker captures reset emails in Mailpit at http://localhost:8025.
# Set a real SMTP host/account for internet email delivery.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_FROM=SocialRecipe <no-reply@socialrecipe.local>
SMTP_USER=
SMTP_PASSWORD=
