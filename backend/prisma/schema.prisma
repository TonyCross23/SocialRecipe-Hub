generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  PUBLISHED
  FLAGGED
  BANNED
  DELETED
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

enum ModerationStatus {
  PENDING
  PROCESSING
  APPROVED
  FLAGGED
  FAILED
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  name              String         @db.VarChar(100)
  email             String         @unique @db.VarChar(254)
  emailVerifiedAt   DateTime?      @db.Timestamptz(3)
  passwordHash      String         @map("password") @db.Text
  image             String?        @db.VarChar(2048)
  dob               DateTime       @db.Date
  roleId            String         @db.Uuid
  status            UserStatus     @default(ACTIVE)
  bannedAt          DateTime?      @db.Timestamptz(3)
  bannedReason      String?        @db.VarChar(1000)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  role              Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  followers         Follow[]       @relation("Following")
  following         Follow[]       @relation("Follower")
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  reports           Report[]
  sessions          AuthSession[]
  refreshTokens     RefreshToken[]
  notifications     Notification[] @relation("Recipient")
  sentNotifications Notification[] @relation("NotificationActor")
  savedPosts        SavedPost[]
  contentFilters    UserFilter[]   @relation("FilterActor")
  filteredBy        UserFilter[]   @relation("FilterTarget")
  shoppingLists     ShoppingList[]
  pushDevices       PushDevice[]

  passwordResets  PasswordReset[]
  appeals         BanAppeal[]     @relation("Applicant")
  reviewedAppeals BanAppeal[]     @relation("Reviewer")

  @@index([roleId])
}

model Notification {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  type         String         @db.VarChar(50)
  title        String         @db.VarChar(200)
  message      String         @db.VarChar(1000)
  data         Json?
  readAt       DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  user         User           @relation("Recipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId      String?        @db.Uuid
  actor        User?          @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  pushQueuedAt DateTime?      @db.Timestamptz(3)
  deliveries   PushDelivery[]

  @@index([actorId])
  @@index([pushQueuedAt, createdAt])
  @@index([userId, readAt, createdAt, id])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(50)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?          @db.Text
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Follow {
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt, followerId])
  @@index([followerId, createdAt, followingId])
}

model Post {
  id             String          @id @default(uuid()) @db.Uuid
  title          String          @db.VarChar(200)
  content        String          @db.Text
  images         String[]        @default([])
  sharesCount    Int             @default(0)
  isRepost       Boolean         @default(false)
  sharedPostId   String?         @db.Uuid
  sharedPost     Post?           @relation("Reposts", fields: [sharedPostId], references: [id], onDelete: SetNull)
  reposts        Post[]          @relation("Reposts")
  status         PostStatus      @default(PUBLISHED)
  visibility     PostVisibility  @default(PUBLIC)
  userId         String          @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments       Comment[]
  likes          Like[]
  reports        Report[]
  moderationJobs ModerationJob[]
  recipe         Json?
  savedBy        SavedPost[]

  @@index([sharedPostId])
  @@index([status, visibility, createdAt, id])
  @@index([userId, createdAt, id])
}

model Comment {
  id             String          @id @default(uuid()) @db.Uuid
  content        String          @db.Text
  status         PostStatus      @default(PUBLISHED)
  postId         String          @db.Uuid
  userId         String          @db.Uuid
  parentId       String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  post           Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Composite relation prevents replies to comments on a different post.
  parent         Comment?        @relation("Replies", fields: [parentId, postId], references: [id, postId], onDelete: NoAction, onUpdate: NoAction)
  replies        Comment[]       @relation("Replies")
  likes          Like[]
  reports        Report[]
  moderationJobs ModerationJob[]

  @@unique([id, postId])
  @@index([postId, createdAt, id])
  @@index([parentId, postId])
  @@index([userId])
}

model Like {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String?  @db.Uuid
  commentId String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reason     String       @db.VarChar(2000)
  status     ReportStatus @default(PENDING)
  reporterId String       @db.Uuid
  postId     String?      @db.Uuid
  commentId  String?      @db.Uuid
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt, id])
  @@index([reporterId])
  @@index([postId])
  @@index([commentId])
}

model PolicySetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

// Durable outbox for the later moderation worker. Create atomically with content.
model ModerationJob {
  id          String           @id @default(uuid()) @db.Uuid
  postId      String?          @db.Uuid
  commentId   String?          @db.Uuid
  status      ModerationStatus @default(PENDING)
  attempts    Int              @default(0)
  availableAt DateTime         @default(now()) @db.Timestamptz(3)
  lockedAt    DateTime?        @db.Timestamptz(3)
  result      Json?
  lastError   String?          @db.Text
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, id])
  @@index([postId])
  @@index([commentId])
}

model AuthSession {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  expiresAt   DateTime       @db.Timestamptz(3)
  revokedAt   DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens      RefreshToken[]
  pushDevices PushDevice[]

  @@unique([id, userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id        String      @id @db.Uuid
  tokenHash String      @unique @db.Char(64)
  userId    String      @db.Uuid
  sessionId String      @db.Uuid
  expiresAt DateTime    @db.Timestamptz(3)
  usedAt    DateTime?   @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   AuthSession @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Cascade)

  @@index([sessionId, userId])
  @@index([expiresAt])
}

model SavedPost {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt, postId])
  @@index([postId])
}

model UserFilter {
  actorId   String   @db.Uuid
  targetId  String   @db.Uuid
  kind      String   @db.VarChar(5)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  actor     User     @relation("FilterActor", fields: [actorId], references: [id], onDelete: Cascade)
  target    User     @relation("FilterTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([actorId, targetId, kind])
  @@index([targetId, kind])
}

model ShoppingList {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  title     String         @db.VarChar(200)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ShoppingItem[]

  @@index([userId, createdAt, id])
}

model ShoppingItem {
  id       String       @id @default(uuid()) @db.Uuid
  listId   String       @db.Uuid
  name     String       @db.VarChar(200)
  quantity String       @db.VarChar(100)
  checked  Boolean      @default(false)
  position Int
  list     ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId, position])
}

model PushDevice {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  sessionId  String         @db.Uuid
  token      String         @unique @db.VarChar(256)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    AuthSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@index([userId])
  @@index([sessionId])
}

model PushDelivery {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @db.Uuid
  deviceId       String       @db.Uuid
  status         String       @default("PENDING") @db.VarChar(12)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @db.Timestamptz(3)
  lockedAt       DateTime?    @db.Timestamptz(3)
  ticketId       String?      @db.VarChar(100)
  lastError      String?      @db.VarChar(100)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device         PushDevice   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([notificationId, deviceId])
  @@index([status, availableAt])
}

model PasswordReset {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @db.Char(64)
  attempts  Int       @default(0)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model BanAppeal {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  bannedAt   DateTime  @db.Timestamptz(3)
  message    String    @db.VarChar(2000)
  status     String    @default("PENDING") @db.VarChar(10)
  response   String?   @db.VarChar(1000)
  reviewerId String?   @db.Uuid
  reviewedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer   User?     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt, id])
  @@index([userId, createdAt])
  @@index([reviewerId])
}

model PendingRegistration {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @db.VarChar(254)
  name         String    @db.VarChar(100)
  passwordHash String    @db.Text
  dob          DateTime  @db.Date
  codeHash     String    @db.Char(64)
  attempts     Int       @default(0)
  sends        Int       @default(1)
  lastSentAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  usedAt       DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([createdAt])
}
