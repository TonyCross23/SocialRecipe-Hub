# Optional administrator bootstrap; existing passwords/status are never reset.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
# Placeholder birthday for the bootstrap account; change to the correct date.
SEED_ADMIN_DOB=2000-01-01
# Change if another local PostgreSQL instance already uses port 5432.
POSTGRES_PORT=5432

# Generate two DIFFERENT values with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-48-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-48-characters

JWT_ISSUER=socialrecipe-api
JWT_AUDIENCE=socialrecipe-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_TTL_SECONDS=2592000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
# For physical-phone testing on the same trusted network, use 0.0.0.0.
API_BIND_ADDRESS=127.0.0.1
# Optional Cloudinary account credentials. Keep these on the backend only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional AI moderation worker configuration.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_WORKER_INTERVAL_MS=5000
# docker:env generates this value when missing or still an example.
METRICS_TOKEN=replace-with-a-random-metrics-token-at-least-32-characters

# Groq conversational AI Cook (server only)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
AI_CHAT_LANGUAGE=english

# Enable after Expo/Firebase push credentials are configured.
PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=

# Docker captures reset emails in Mailpit at http://localhost:8025.
# Set a real SMTP host/account for internet email delivery.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_FROM=SocialRecipe <no-reply@socialrecipe.local>
SMTP_USER=
SMTP_PASSWORD=
