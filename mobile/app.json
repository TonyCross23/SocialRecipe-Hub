{
  "expo": {
    "name": "SocialRecipe Hub",
    "slug": "social-recipe",
    "owner": "tonycross23",
    "extra": {
      "eas": {
        "projectId": "ad826fc2-6d2e-41e8-8138-3f35ce315689"
      }
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "socialrecipe",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.socialrecipe.hub"
    },
    "android": {
      "package": "com.socialrecipe.hub"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your recipes and profile.",
          "cameraPermission": "Take photos for your recipes and profile.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#0866FF",
          "defaultChannel": "community"
        }
      ]
    ]
  }
}
