# Android emulator: http://10.0.2.2:4000/api/v1
# Physical phone: use your computer's LAN IP, with phone on the same network.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
# Cloudinary upload routes in this repository's backend.
# See README.md for the required contracts; never put provider secrets in Expo env.
EXPO_PUBLIC_UPLOAD_PATH=/media/images
EXPO_PUBLIC_REGISTRATION_UPLOAD_PATH=/media/registration-images
# AI Cook uses /assistant/chat; the Groq key belongs only in the backend.

# Optional: EAS project UUID; eas init can instead populate app.json extra.eas.projectId.
EXPO_PUBLIC_EAS_PROJECT_ID=
# For local native builds, absolute path to client google-services.json.
# In EAS configure GOOGLE_SERVICES_JSON as a file environment variable.
